# venvs: .venv is the pipeline venv (torch etc.), .venv-web is the thin web venv
.venv/
.venv-web/
__pycache__/
*.pyc

# secrets and deploy target
.env

# the database is a build product of the pipeline, never committed
pants.db
pants.db-wal
pants.db-shm

# data/raw and data/interim are symlinks to ~/PANTSData (outside iCloud); processed data
# is derived and rebuildable
data/raw
data/interim
data/processed/*
!data/processed/.gitkeep

# precomputed structure assets are shipped by rsync at deploy time, not through git
app/static/structures/*.cif
app/static/structures/*.mmcif

# manifests are provenance for a specific local run
manifests/*.json

# trained head weights and calibration objects
models/*.joblib
models/*.pkl

# session transcripts and scratch
*.txt.session
.DS_Store

# pytest
.pytest_cache/

# macOS/iCloud conflict copies of the database ("pants 2.db" and its WAL/SHM)
*[0-9].db
*[0-9].db-wal
*[0-9].db-shm

# predicted structures are build products, like the mmCIF alongside them
app/static/structures/*.pdb

# Reference structures are build products too: fetched from RCSB or AlphaFold, or folded
# here, then superposed onto IsPETase at write time. 61 MB rebuilt by
# `pipeline/structure/reference.py`, so the recipe is versioned and the output is not.
app/static/reference_structures/

# release bundle is regenerated by scripts/build_release.py
release/
