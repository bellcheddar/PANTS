# Copy to .env and fill in. .env is gitignored.

# --- deploy target ---
DROPLET_SSH=root@your.droplet.ip
DROPLET_PATH=/opt/pants
SERVER_NAME=pants.mdeller.com
# Port 8005: AlphaFraud 8000, chem_sage-web 8001, chatPDB-web 8002,
# BoltzMaker-web 8003, FlexAppeal 8004. PANTS is app six.
BIND_ADDR=127.0.0.1:8005

# --- data version shown in the app footer (spec section 12) ---
DATA_VERSION=dev

# --- pipeline knobs ---
# Refuse a metagenome collection larger than this. Local free disk is ~62 GB and the
# whole v1 footprint is budgeted at ~3.2 GB (PLAN_v1.md risk 5).
MAX_COLLECTION_GB=30
# Top N candidates that get an ESMFold structure in v1.
STRUCTURE_BUDGET=50
MMSEQS_SENSITIVITY=7.5

# --- models ---
# t12-35M, not 650M: the only ESM-2 that fits alongside gunicorn on the droplet.
ESM_MODEL=facebook/esm2_t12_35M_UR50D
ESMFOLD_MODEL=facebook/esmfold_v1
